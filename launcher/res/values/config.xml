<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher settings. Edit, then run launcher/build-and-install.sh.
  Package names: tools/venv/bin/python -I tools/tv.py 'pm list packages'
-->
<resources>
    <!-- Dock apps, left to right, for the first run (up to 6). After that the order is changed on
         the TV with a long press on OK and saved there. Apps that aren't installed are skipped. -->
    <string-array name="dock_apps">
        <item>com.apple.atve.androidtv.appletv</item>
        <item>com.google.android.youtube.tv</item>
        <item>com.netflix.ninja</item>
        <item>com.amazon.amazonvideo.livingroom</item>
        <item>com.disney.disneyplus</item>
        <item>com.wbd.stream</item>
    </string-array>

    <!-- Show another installed app's own banner and icon on an app's tile: "app=iconApp", or
         "app=iconApp|Label" to also change the label. Nothing is bundled: if iconApp isn't
         installed, the app keeps its own icon. -->
    <string-array name="icon_aliases">
        <item>org.smarttube.stable=com.google.android.youtube.tv|SmartTube</item>
    </string-array>

    <!-- Never shown as tiles in the All Apps grid. Add package names here to hide them. -->
    <string-array name="hidden_apps">
    </string-array>

    <!-- The TV's Live TV / tuner app, listed last in the Inputs menu. Empty to leave it out.
         Common ones: com.tcl.tv (TCL), com.mediatek.wwtv.tvcenter (Xiaomi, many MediaTek sets),
         com.google.android.tv (Google Live Channels), com.sony.dtv.tvx (Sony). -->
    <string name="live_tv_package" translatable="false"></string>

    <!-- The manufacturer's own source picker, used if switching to an input directly fails. -->
    <string name="input_picker_package" translatable="false"></string>

    <!-- Tiles per row in the grid. -->
    <integer name="columns">5</integer>

    <!-- Night mode: from night_start_hour until night_end_hour (0 to 23, device clock) the photo is
         dimmed a little more; the text stays the same. The window may cross midnight. -->
    <bool name="night_mode_enabled">true</bool>
    <integer name="night_start_hour">22</integer>
    <integer name="night_end_hour">6</integer>

    <!-- Weather line under the date, from Open-Meteo (no key). Timezone sets which day's high/low. -->
    <string name="weather_city" translatable="false">Melbourne</string>
    <string name="weather_latitude" translatable="false">-37.8136</string>
    <string name="weather_longitude" translatable="false">144.9631</string>
    <string name="weather_timezone" translatable="false">Australia/Melbourne</string>
    <!-- The day counts as windy from this maximum gust (km/h): the wind icon and "Windy today" on a
         dry day, ", windy" after the words on a wet one. -->
    <integer name="windy_gust_kmh">50</integer>

    <!-- Schedule card: today's events from the iCal links in launcher/calendar.env (git-ignored),
         in this time zone. Set show_event_titles to false to show only times and "Busy". -->
    <string name="calendar_timezone" translatable="false">Australia/Melbourne</string>
    <bool name="show_event_titles">true</bool>

    <!-- Verse of the day: the bundled list (references, plus BSB text used whenever the ESV can't be),
         and the label shown on the card for that fallback text. -->
    <string name="verse_file" translatable="false">verses/bsb.tsv</string>
    <string name="verse_translation" translatable="false">BSB</string>
    <!-- Take the day's reference from the YouVersion Platform verse of the day (needs
         launcher/youversion.env and the ESV key), shown in the ESV. False: the bundled list only. -->
    <bool name="use_youversion_votd">true</bool>
    <!-- Crossway's ESV copyright notice (res/values/esv.xml) as a dim line along the bottom edge
         while ESV text is shown; the ESV API terms require it. Off: the notice is not shown at all
         and the card still says ESV. A SHOW_ESV_NOTICE=false line in launcher/esv.env (git-ignored)
         hides it on your own build without changing this file. Hiding it is your responsibility. -->
    <bool name="show_esv_notice">true</bool>
</resources>
